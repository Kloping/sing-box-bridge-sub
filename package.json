{
  "name": "sing-box-bridge-sub",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "可视化的 sing-box bridge/sub 桌面工具",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node --test \"src/main/*.test.cjs\""
  },
  "build": {
    "appId": "com.kloping.singboxbridgesub",
    "productName": "Sing-box Bridge Sub",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "icon": "src/logo.png"
    }
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "undici": "^6.28.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  }
}
